{
  "name": "tianjige-market-intel",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "天机阁：股票、投资、科技、数码、体育、经济与政策中文实时资讯软件",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server.js",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "jsdom": "^30.0.1",
    "lucide": "^0.468.0",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tianjige.marketintel",
    "productName": "天机阁",
    "artifactName": "天机阁-${version}-Windows-${arch}.${ext}",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "天机阁"
    }
  }
}
